{
  "id": "/app",
  "name": "LMSGEN Learning Platform",
  "short_name": "LMSGEN",
  "description": "Create, deliver and track learning with LMSGEN.",
  "start_url": "/app.html?__lmsgen_route=%2Fapp",
  "scope": "/",
  "display": "standalone",
  "background_color": "#061311",
  "theme_color": "#17978d",
  "orientation": "any",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/branding/lmsgen-app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/branding/lmsgen-app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/branding/lmsgen-app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My Courses",
      "short_name": "Courses",
      "url": "/scorm/courses",
      "icons": [{ "src": "/branding/lmsgen-app-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Awareness Emails",
      "short_name": "Awareness",
      "url": "/scorm/awareness-templates",
      "icons": [{ "src": "/branding/lmsgen-app-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Publica",
      "url": "/scorm/publica",
      "icons": [{ "src": "/branding/lmsgen-app-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
